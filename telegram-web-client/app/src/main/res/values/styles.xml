<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TelegramWebClient" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/clay_primary</item>
        <item name="android:navigationBarColor">@color/clay_background</item>
        <item name="android:windowSplashScreenContent">@style/SplashScreen</item>
        <item name="android:windowBackground">@color/clay_background</item>
        <item name="android:windowBackgroundDimEnabled">false</item>
        <item name="materialColorPrimary">@color/clay_primary</item>
        <item name="materialColorPrimaryVariant">@color/clay_primary_dark</item>
        <item name="materialColorSecondary">@color/clay_accent</item>
        <item name="materialColorSecondaryVariant">@color/clay_accent_dark</item>
        <item name="android:textColor">@color/clay_text_primary</item>
        <item name="android:textColorPrimary">@color/clay_text_primary</item>
        <item name="android:textColorSecondary">@color/clay_text_secondary</item>
    </style>

    <style name="Theme.TelegramWebClient.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/clay_primary_dark</item>
        <item name="android:navigationBarColor">@color/clay_background_dark</item>
        <item name="android:windowSplashScreenContent">@style/SplashScreen.Dark</item>
        <item name="android:windowBackground">@color/clay_background_dark</item>
        <item name="materialColorPrimary">@color/clay_primary_dark</item>
        <item name="materialColorPrimaryVariant">@color/clay_primary</item>
        <item name="materialColorSecondary">@color/clay_accent_dark</item>
        <item name="materialColorSecondaryVariant">@color/clay_accent</item>
        <item name="android:textColor">@color/clay_text_primary_dark</item>
        <item name="android:textColorPrimary">@color/clay_text_primary_dark</item>
        <item name="android:textColorSecondary">@color/clay_text_secondary_dark</item>
    </style>

    <style name="SplashScreen" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/clay_background</item>
        <item name="android:statusBarColor">@color/clay_primary</item>
    </style>

    <style name="SplashScreen.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/clay_background_dark</item>
        <item name="android:statusBarColor">@color/clay_primary_dark</item>
    </style>

    <!-- Claymorphism card style -->
    <style name="Widget.ClayCard" parent="Theme.Material3.CardView">
        <item name="android:background">@color/clay_surface</item>
        <item name="app:cardCornerRadius">24dp</item>
        <item name="app:cardElevation">6dp</item>
        <item name="app:cardShadowColor">@color/clay_shadow</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Widget.ClayCard.Dark" parent="Theme.Material3.CardView">
        <item name="android:background">@color/clay_surface_dark</item>
        <item name="app:cardCornerRadius">24dp</item>
        <item name="app:cardElevation">8dp</item>
        <item name="app:cardShadowColor">@color/clay_shadow_dark</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Claymorphism button -->
    <style name="Widget.ClayButton" parent="Theme.Material3.Button.TextButton">
        <item name="android:textColor">@color/clay_text_primary</item>
        <item name="android:background">@drawable/clay_button_background</item>
        <item name="app:iconTint">@color/clay_accent</item>
    </style>

    <style name="Widget.ClayButton.Dark" parent="Theme.Material3.Button.TextButton">
        <item name="android:textColor">@color/clay_text_primary_dark</item>
        <item name="android:background">@drawable/clay_button_background_dark</item>
        <item name="app:iconTint">@color/clay_accent_dark</item>
    </style>
</resources>