<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:app="http://schemas.android.com/apk/res-auto">
    <style name="Theme.TelegramWebClient" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/clay_primary</item>
        <item name="android:navigationBarColor">@color/clay_background</item>
        <item name="android:windowBackground">@color/clay_background</item>
        <item name="colorPrimary">@color/clay_primary</item>
        <item name="colorPrimaryVariant">@color/clay_primary_dark</item>
        <item name="colorSecondary">@color/clay_accent</item>
        <item name="colorSecondaryVariant">@color/clay_accent_dark</item>
        <item name="colorSurface">@color/clay_surface</item>
        <item name="colorOnSurface">@color/clay_text_primary</item>
        <item name="android:textColorPrimary">@color/clay_text_primary</item>
        <item name="android:textColorSecondary">@color/clay_text_secondary</item>
    </style>

    <style name="Theme.TelegramWebClient.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/clay_primary_dark</item>
        <item name="android:navigationBarColor">@color/clay_background_dark</item>
        <item name="android:windowBackground">@color/clay_background_dark</item>
        <item name="colorPrimary">@color/clay_primary_dark</item>
        <item name="colorPrimaryVariant">@color/clay_primary</item>
        <item name="colorSecondary">@color/clay_accent_dark</item>
        <item name="colorSecondaryVariant">@color/clay_accent</item>
        <item name="colorSurface">@color/clay_surface_dark</item>
        <item name="colorOnSurface">@color/clay_text_primary_dark</item>
        <item name="android:textColorPrimary">@color/clay_text_primary_dark</item>
        <item name="android:textColorSecondary">@color/clay_text_secondary_dark</item>
    </style>

    <style name="SplashScreen" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/clay_background</item>
        <item name="android:statusBarColor">@color/clay_primary</item>
    </style>

    <style name="SplashScreen.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/clay_background_dark</item>
        <item name="android:statusBarColor">@color/clay_primary_dark</item>
    </style>

    <!-- Claymorphism card style -->
    <style name="Widget.ClayCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/clay_surface</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">6dp</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Widget.ClayCard.Dark" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/clay_surface_dark</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">8dp</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Claymorphism button -->
    <style name="Widget.ClayButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/clay_text_primary</item>
        <item name="android:background">@drawable/clay_button_background</item>
        <item name="iconTint">@color/clay_accent</item>
    </style>

    <style name="Widget.ClayButton.Dark" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/clay_text_primary_dark</item>
        <item name="android:background">@drawable/clay_button_background_dark</item>
        <item name="iconTint">@color/clay_accent_dark</item>
    </style>

    <!-- Claymorphism account selector pill: puffy surface + chevron affordance -->
    <style name="Widget.ClayPillButton" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/clay_pill</item>
        <item name="backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/clay_text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="iconTint">@color/clay_text_secondary</item>
        <item name="iconGravity">textEnd</item>
        <item name="iconPadding">6dp</item>
    </style>

    <!-- Claymorphism circular icon button (add) -->
    <style name="Widget.ClayIconButton" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/clay_icon_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/clay_text_primary</item>
    </style>

    <!-- Accent variant for the destructive delete action -->
    <style name="Widget.ClayIconButton.Accent">
        <item name="android:background">@drawable/clay_icon_button_accent</item>
        <item name="iconTint">@color/clay_text_primary</item>
    </style>
</resources>
